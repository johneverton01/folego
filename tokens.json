{
  "$description": "Fôlego — design tokens (formato W3C Design Tokens / DTCG). Fonte da verdade do design system. Cores semânticas têm variação para tema claro e escuro; cores de dados são fixas.",
  "color": {
    "$description": "Camada semântica. 'light' e 'dark' compartilham as mesmas chaves — troque o tema, não o nome do token.",
    "palette": {
      "$description": "Cores fixas nos dois temas.",
      "on-accent": { "$type": "color", "$value": "#FFFFFF", "$description": "Texto/ícone sobre superfícies accent" },
      "cat-casa":        { "$type": "color", "$value": "#268C5C" },
      "cat-comida":      { "$type": "color", "$value": "#7FB98F" },
      "cat-impostos":    { "$type": "color", "$value": "#C9871E" },
      "cat-lazer":       { "$type": "color", "$value": "#7C9CE0" },
      "cat-transporte":  { "$type": "color", "$value": "#5FB0C9" },
      "cat-assinaturas": { "$type": "color", "$value": "#B98FD0" },
      "cat-outros":      { "$type": "color", "$value": "#B0938A" }
    },
    "light": {
      "paper":        { "$type": "color", "$value": "#F1F5F0", "$description": "Fundo da página" },
      "surface":      { "$type": "color", "$value": "#FFFFFF", "$description": "Card / superfície elevada" },
      "surface-2":    { "$type": "color", "$value": "#F7FAF6", "$description": "Superfície recuada" },
      "ink":          { "$type": "color", "$value": "#14231F", "$description": "Texto principal" },
      "ink-soft":     { "$type": "color", "$value": "#4E605A", "$description": "Texto de apoio" },
      "ink-faint":    { "$type": "color", "$value": "#84968F", "$description": "Legenda / placeholder" },
      "line":         { "$type": "color", "$value": "#DFE7DE", "$description": "Bordas e divisórias" },
      "accent":       { "$type": "color", "$value": "#268C5C", "$description": "Marca / ação primária" },
      "accent-deep":  { "$type": "color", "$value": "#1B6644", "$description": "Marca sobre claro / texto de link" },
      "accent-wash":  { "$type": "color", "$value": "#E6F2EA", "$description": "Fundo suave da marca / anel de foco" },
      "ok":           { "$type": "color", "$value": "#2FA36B", "$description": "Sinal saudável (semáforo verde)" },
      "amber":        { "$type": "color", "$value": "#C9871E", "$description": "Sinal de atenção" },
      "amber-wash":   { "$type": "color", "$value": "#F8EFDB" },
      "red":          { "$type": "color", "$value": "#CE5442", "$description": "Sinal de risco" },
      "red-wash":     { "$type": "color", "$value": "#F8E7E2" }
    },
    "dark": {
      "paper":        { "$type": "color", "$value": "#0D1815" },
      "surface":      { "$type": "color", "$value": "#132320" },
      "surface-2":    { "$type": "color", "$value": "#0F1E1A" },
      "ink":          { "$type": "color", "$value": "#E9F2EC" },
      "ink-soft":     { "$type": "color", "$value": "#9DB2AA" },
      "ink-faint":    { "$type": "color", "$value": "#6C8079" },
      "line":         { "$type": "color", "$value": "#233A32" },
      "accent":       { "$type": "color", "$value": "#48BD84" },
      "accent-deep":  { "$type": "color", "$value": "#6BD3A0" },
      "accent-wash":  { "$type": "color", "$value": "#152C22" },
      "ok":           { "$type": "color", "$value": "#4FC085" },
      "amber":        { "$type": "color", "$value": "#E0A63C" },
      "amber-wash":   { "$type": "color", "$value": "#2B2416" },
      "red":          { "$type": "color", "$value": "#E5705B" },
      "red-wash":     { "$type": "color", "$value": "#2E1B18" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Bricolage Grotesque", "system-ui", "sans-serif"], "$description": "Títulos e o número-herói" },
      "sans":    { "$type": "fontFamily", "$value": ["IBM Plex Sans", "system-ui", "sans-serif"], "$description": "Interface e corpo" },
      "mono":    { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "monospace"], "$description": "Exclusivo para valores em R$" }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "clamp(2.4rem, 6vw, 3.7rem)", "$description": "Número-herói (meses de fôlego)" },
      "h1":      { "$type": "dimension", "$value": "2rem" },
      "h2":      { "$type": "dimension", "$value": "1.7rem" },
      "h3":      { "$type": "dimension", "$value": "1.2rem" },
      "body":    { "$type": "dimension", "$value": "1rem" },
      "sm":      { "$type": "dimension", "$value": "0.875rem" },
      "xs":      { "$type": "dimension", "$value": "0.8125rem" },
      "money":   { "$type": "dimension", "$value": "1.5rem", "$description": "Valor em R$ no razão; use com font.family.mono" }
    },
    "lineHeight": {
      "tight":   { "$type": "number", "$value": 1.1 },
      "snug":    { "$type": "number", "$value": 1.25 },
      "normal":  { "$type": "number", "$value": 1.5 }
    }
  },
  "space": {
    "$description": "Escala base 4px. Coincide com a escala padrão do Tailwind (1=4px … 16=64px).",
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "tab":     { "$type": "dimension", "$value": "9px", "$description": "Abas, botões de ícone" },
    "control": { "$type": "dimension", "$value": "12px", "$description": "Inputs, botões, superfícies pequenas" },
    "card":    { "$type": "dimension", "$value": "18px", "$description": "Cards e superfícies grandes" },
    "pill":    { "$type": "dimension", "$value": "9999px", "$description": "Chips, badges, toasts" }
  },
  "shadow": {
    "float": {
      "$type": "shadow",
      "$description": "Sombra única para o que flutua: herói, cards de destaque, modais, toast. Superfícies comuns usam borda, não sombra.",
      "$value": [
        { "color": "#14231F0A", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
        { "color": "#14231F2E", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-12px" }
      ]
    }
  },
  "motion": {
    "duration": {
      "fade":    { "$type": "duration", "$value": "180ms", "$description": "Fundo do modal" },
      "pop":     { "$type": "duration", "$value": "220ms", "$description": "Entrada do modal" },
      "rise":    { "$type": "duration", "$value": "350ms", "$description": "Troca de aba/visão" },
      "breathe": { "$type": "duration", "$value": "5500ms", "$description": "Respiração do símbolo (loop)" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] },
      "pop":      { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.3, 1] }
    }
  }
}
