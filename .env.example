# Postgres (via docker-compose.yml: `docker compose up -d`)
DATABASE_URL="postgresql://folego:folego@localhost:5432/folego?schema=public"

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Login com Google (https://console.cloud.google.com/apis/credentials)
# Redirect URI autorizada: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
