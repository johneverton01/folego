generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())
}

// ─── Better Auth ──────────────────────────────────────────────────────────────
// Espelha as tabelas do core + plugin twoFactor (better-auth 1.7).
// Ao adicionar plugins que criam tabelas/campos, atualize aqui e rode `pnpm db:migrate`.

model User {
  id               String      @id
  name             String
  email            String      @unique
  emailVerified    Boolean     @default(false)
  image            String?
  twoFactorEnabled Boolean?    @default(false)
  /// Ajuste em centavos pra reserva bater com o saldo informado; pode ser negativo. Nulo: ainda não informou.
  saldoInicial     Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  lancamentos      Lancamento[]
  metas            Meta[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// ─── Finanças ─────────────────────────────────────────────────────────────────

enum TipoLancamento {
  entrada
  saida
}

model Lancamento {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  desc      String
  /// Valor em centavos, sempre positivo; o sinal vem de `tipo`.
  valor     Int
  cat       String         @default("Outros")
  tipo      TipoLancamento
  data      DateTime       @db.Date
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, data])
  @@map("lancamento")
}

model Meta {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome        String
  /// Valores em centavos.
  valorAlvo   Int
  valorMensal Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  aportes     Aporte[]

  @@index([userId])
  @@map("meta")
}

model Aporte {
  id        String   @id @default(cuid())
  metaId    String
  meta      Meta     @relation(fields: [metaId], references: [id], onDelete: Cascade)
  /// Valor em centavos.
  valor     Int
  data      DateTime @db.Date
  createdAt DateTime @default(now())

  @@index([metaId, data])
  @@map("aporte")
}
